{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    //
    // NOTE: Android/iOS product flavors now exist, so every config must pass a
    // --flavor. `toolArgs` are passed to the `flutter` tool (flavor, dart-define);
    // `program` sets the entrypoint (-t).
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Pixely (original)",
            "request": "launch",
            "type": "dart",
            "program": "lib/main.dart",
            "toolArgs": ["--flavor", "original", "--dart-define=FLAVOR=original"]
        },
        {
            "name": "Pixely (original, profile)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "profile",
            "program": "lib/main.dart",
            "toolArgs": ["--flavor", "original", "--dart-define=FLAVOR=original"]
        },
        {
            "name": "Pixely (original, release)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "release",
            "program": "lib/main.dart",
            "toolArgs": ["--flavor", "original", "--dart-define=FLAVOR=original"]
        },
        {
            "name": "Divine Pixels (devotional)",
            "request": "launch",
            "type": "dart",
            "program": "lib/main_devotional.dart",
            "toolArgs": ["--flavor", "devotional", "--dart-define=FLAVOR=devotional"]
        },
        {
            "name": "Divine Pixels (devotional, profile)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "profile",
            "program": "lib/main_devotional.dart",
            "toolArgs": ["--flavor", "devotional", "--dart-define=FLAVOR=devotional"]
        },
        {
            "name": "Divine Pixels (devotional, release)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "release",
            "program": "lib/main_devotional.dart",
            "toolArgs": ["--flavor", "devotional", "--dart-define=FLAVOR=devotional"]
        }
    ]
}
